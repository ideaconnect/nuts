{
	admin off
	order nuts before respond
}

:8080 {
	# Access logging wraps the response writer in Caddy's recorder (no
	# http.Flusher); keeping it on guards the streaming path against #114.
	log

	handle /health {
		respond 200
	}

	# Prometheus metrics, nuts_* included, for scenarios that assert them.
	handle /metrics {
		metrics
	}

	handle /events* {
		uri strip_prefix /events
		nuts {
			nats_url {$NATS_URL:nats://localhost:4222}
			stream_name {$STREAM_NAME:EVENTS}
			topic_prefix {$TOPIC_PREFIX:events.}
			heartbeat_interval 1
			nats_idle_heartbeat 1
			allowed_origins *
		}
	}

	# The same stream with shared subscriptions, for features/shared_subscriptions.feature.
	handle /shared* {
		uri strip_prefix /shared
		nuts {
			nats_url {$NATS_URL:nats://localhost:4222}
			stream_name {$STREAM_NAME:EVENTS}
			topic_prefix {$TOPIC_PREFIX:events.}
			heartbeat_interval 1
			nats_idle_heartbeat 1
			allowed_origins *
			shared_subscriptions
		}
	}

	handle /example* {
		root * /srv/example
		uri strip_prefix /example
		file_server browse
	}

	handle {
		nuts {
			nats_url {$NATS_URL:nats://localhost:4222}
			stream_name {$STREAM_NAME:EVENTS}
			topic_prefix {$TOPIC_PREFIX:events.}
			heartbeat_interval 1
			nats_idle_heartbeat 1
			allowed_origins *
		}
	}
}
